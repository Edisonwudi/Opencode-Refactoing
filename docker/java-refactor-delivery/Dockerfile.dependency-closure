ARG DEPENDENCY_BASE_IMAGE=opencode-java-refactor-delivery:0.1.3-r7.3.20-rb-certified-v1
FROM ${DEPENDENCY_BASE_IMAGE}

USER root

COPY docker/java-refactor-delivery/maven-online-settings.xml \
  /tmp/maven-online-settings.xml
COPY scripts/normalize_maven_offline_repo.py \
  /tmp/normalize_maven_offline_repo.py

# Resolve the exact dependency closure of dataset commands that were not
# covered by the original delivery image. Build output stays in this staging
# image; the mounted-source environment copies only the certified build
# environment.
RUN set -eu; \
  cd /opt/projects/tika; \
  export JAVA_HOME=/opt/buildenv/jdks/temurin-17; \
  export PATH="${JAVA_HOME}/bin:${PATH}"; \
  repository=/opt/buildenv/offline-home/.m2/repository; \
  modules="tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-pdf-module,tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-apple-module,tika-parsers/tika-parsers-standard/tika-parsers-standard-modules/tika-parser-audiovideo-module,tika-parsers/tika-parsers-standard/tika-parsers-standard-integration-tests,tika-pipes/tika-pipes-fork-parser,tika-pipes/tika-pipes-plugins/tika-pipes-solr,tika-pipes/tika-pipes-plugins/tika-pipes-s3,tika-pipes/tika-pipes-plugins/tika-pipes-kafka,tika-pipes/tika-pipes-plugins/tika-pipes-jdbc,tika-pipes/tika-pipes-plugins/tika-pipes-microsoft-graph,tika-pipes/tika-pipes-plugins/tika-pipes-google-drive"; \
  ./mvnw \
    --errors \
    --show-version \
    --batch-mode \
    --no-transfer-progress \
    -s /tmp/maven-online-settings.xml \
    -Dmaven.repo.local="${repository}" \
    -Dpmd.skip=true \
    -Dossindex.skip \
    -Dcheckstyle.skip=true \
    -Dforbiddenapis.skip=true \
    -pl "${modules}" \
    -am \
    dependency:go-offline

# Jcseg's original executable test path invokes package and
# dependency:build-classpath. Exercise that exact lifecycle online so all
# lifecycle/reporting plugins are available later with Maven -o.
RUN set -eu; \
  cd /opt/projects/jcseg-573874f; \
  export JAVA_HOME=/opt/buildenv/jdks/zulu-8; \
  export PATH="${JAVA_HOME}/bin:${PATH}"; \
  repository=/opt/buildenv/offline-home/.m2/repository; \
  mvn \
    --errors \
    --show-version \
    --batch-mode \
    --no-transfer-progress \
    -s /tmp/maven-online-settings.xml \
    -Dmaven.repo.local="${repository}" \
    -Dcheckstyle.skip=true \
    -Dspotless.check.skip=true \
    -Dspotless.apply.skip=true \
    -Dpmd.skip=true \
    -pl jcseg-core \
    -am \
    -DskipTests=true \
    package \
    dependency:build-classpath \
    -DincludeScope=runtime \
    -Dmdep.outputFile=target/runtime.classpath

RUN set -eu; \
  repository=/opt/buildenv/offline-home/.m2/repository; \
  python3 /tmp/normalize_maven_offline_repo.py \
    --repository "${repository}" \
    --repository-id local-all; \
  python3 /tmp/normalize_maven_offline_repo.py \
    --check \
    --repository "${repository}" \
    --repository-id local-all; \
  test -z "$(find "${repository}" -type f -name '*.lastUpdated' -print -quit)"

LABEL org.opencontainers.refactor.dependency-closure="dataset-command-closure-v3"
